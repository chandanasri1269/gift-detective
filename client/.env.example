# Gift Detective Client Environment Variables

# Backend API Base URL
# - Leave blank or omit when using unified single-server deployment or same-domain proxy (defaults to /api)
# - Set when client is hosted separately from the backend (e.g., Vercel frontend + Render backend)
# Example:
# VITE_API_BASE_URL=https://gift-detective-api.onrender.com/api
VITE_API_BASE_URL=
